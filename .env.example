# OpsPilot 环境变量模板
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实密钥。
APP_ENV=development
APP_NAME=opspilot
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
# 知识库目录：启动时全量 ingest 该目录下的文档。
KNOWLEDGE_DIR=knowledge

# LLM（可选）。留空时进入离线 provider：意图走规则，答案只引用证据节选。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Dense retrieval: local BAAI/bge-small-zh-v1.5 (~90MB).
# Remote OpenAI-compatible API wins if both KEY and BASE_URL are set.
# APP_ENV=testing skips the model unless LOCAL_EMBEDDING_FORCE=true.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-small-zh-v1.5
EMBEDDING_DIM=512
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=
LOCAL_EMBEDDING_FORCE=false

# Rerank: local Cross-Encoder (BAAI/bge-reranker-base).
# pip install -e ".[rerank]" then the first request downloads weights.
# APP_ENV=testing skips the model unless CROSS_ENCODER_FORCE=true.
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_DEVICE=
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_FORCE=false
# Hugging Face 在国内常超时；sentence-transformers 认这个镜像变量。
HF_ENDPOINT=https://hf-mirror.com

# Document ingest: Unstructured for PDF/Office/HTML/images. Markdown heading
# split is the fallback when the extra is missing or APP_ENV=testing.
# pip install -e ".[docs]" plus system packages: poppler, tesseract+chi_sim,
# libreoffice (for DOCX/PPTX).
UNSTRUCTURED_ENABLED=true
UNSTRUCTURED_STRATEGY=auto
UNSTRUCTURED_OCR_LANGUAGES=chi_sim+eng
UNSTRUCTURED_FORCE=false

# MCP: local tools are registered by default; set a URL to add a remote HTTP tool.
MCP_ENABLED=true
MCP_REMOTE_URL=

# Persistence：本地快速启动使用 SQLite + 进程内缓存/向量库。
# docker-compose.single.yml 会覆盖为 PostgreSQL + Redis；
# docker-compose.multi.yml 再增加 Qdrant。默认 docker-compose.yml 不启动这些依赖。
DATABASE_URL=sqlite+aiosqlite:///./data/local/app.db
REDIS_URL=
QDRANT_URL=
QDRANT_COLLECTION=ops_knowledge

# compose single/multi 必填；只在本地 .env 设置，不要写进仓库。
POSTGRES_PASSWORD=

# Retrieval
RETRIEVAL_TOP_K_SIMPLE=3
RETRIEVAL_TOP_K_COMPLEX=8
RRF_K=60
RERANK_TOP_N=5
MAX_RETRIEVAL_HOPS=3

# Memory
TOKEN_BUDGET=128000
COMPRESS_SOFT_RATIO=0.50
COMPRESS_HARD_RATIO=0.70
AUTO_COMPACT_RATIO=0.85

# Agent
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=6
# Planner → Executor → Critic 后允许的定向修正轮数（检索或重规划）。
MAX_CORRECTION_ROUNDS=2

# Rate limit / cache / admin
RATE_LIMIT_PER_MINUTE=60
RETRIEVAL_CACHE_TTL_SECONDS=60
ADMIN_API_TOKEN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ---- Ops plane ----
# 当前共 12 个只读运维工具；另有 search_knowledge / escalate_to_human /
# mcp_change_window / mcp_oncall_roster。写工具 restart_service 默认不注册。
# mock = JSON fixtures only (default); local = same-host capability adapter;
# ssh = remote adapter (skeleton, not implemented).
OPS_TOOL_BACKEND=mock
OPS_FIXTURES_DIR=app/ops/data
OPS_DEFAULT_HOST=lab-node-1
# Allow-list is the authorisation model: a host outside it is denied.
OPS_ALLOWED_HOSTS=lab-node-1,lab-node-2
# restart_service only runs against the mock backend and only after confirmation.
OPS_ENABLE_WRITE_TOOLS=false
# Hard per-tool budget enforced by asyncio.wait_for in Tool.run(), not by the tool.
TOOL_TIMEOUT_SECONDS=8
# Second-round retrieval budget after a tool round.
MAX_EVIDENCE_HOPS=2
# Confirmation store: auto = Redis when REDIS_URL is set, otherwise DISABLED (503).
# memory is test-only. Never silently falls back to an in-process dict.
PENDING_STORE_BACKEND=auto
PENDING_ACTION_TTL_SECONDS=900
